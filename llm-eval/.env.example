# Baseline endpoint
BASELINE_BASE_URL=https://api.example.com/v1
BASELINE_API_KEY=replace-with-a-local-secret
BASELINE_MODEL=baseline-model
BASELINE_API_KEY_HEADER=authorization

# Candidate endpoint
CANDIDATE_BASE_URL=https://api.example.com/v1
CANDIDATE_API_KEY=replace-with-a-local-secret
CANDIDATE_MODEL=candidate-model
CANDIDATE_API_KEY_HEADER=authorization

# Optional USD pricing per one million tokens
BASELINE_INPUT_COST_PER_MILLION=
BASELINE_OUTPUT_COST_PER_MILLION=
CANDIDATE_INPUT_COST_PER_MILLION=
CANDIDATE_OUTPUT_COST_PER_MILLION=

# Optional JSON objects for Azure-style or other compatible endpoints.
# Never place real credentials here; configure sensitive headers in your local .env.
BASELINE_HEADERS_JSON={}
BASELINE_QUERY_JSON={}
CANDIDATE_HEADERS_JSON={}
CANDIDATE_QUERY_JSON={}

REQUEST_TIMEOUT_MS=60000
MAX_RETRIES=2
