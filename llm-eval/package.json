{
  "name": "@galaktikuzay/llm-eval",
  "version": "0.1.0",
  "description": "Provider-agnostic evaluation toolkit for OpenAI-compatible multilingual LLM endpoints",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
